{
  "name": "@tendstead/lookout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Elastic-2.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/keep-embed-directory.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/patch-shared-ui.mjs"
  },
  "dependencies": {
    "@tendstead/ui": "0.1.2",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "@playwright/test": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
